# Runtime data (the app recreates both). Anchored so backend/data is NOT ignored:
# the ephemeris assets and the seed scripts live there and must be committed.
/data/
/workspace/

backend/.venv/
backend/.pytest-cache/
backend/.pytest-tmp/
**/__pycache__/
*.pyc

frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/dist/

.DS_Store
*.log
